@prefix schema: <https://schema.org/> .
@prefix crdts: <https://vocab.noeldemartin.com/crdt/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#it>
  a schema:TVSeries ;
  schema:containsSeason <#season-1> ;
  schema:name "Freaks and Geeks" .

<#it-metadata>
  a crdts:Metadata ;
  crdts:resource <#it> ;
  crdts:createdAt "2026-06-01T17:27:18.047Z"^^xsd:dateTime ;
  crdts:updatedAt "2026-06-01T17:27:25.511Z"^^xsd:dateTime .

<#watching>
  a schema:WatchAction ;
  schema:object <#it> ;
  schema:actionStatus schema:ActiveActionStatus .

<#watching-metadata>
  a crdts:Metadata ;
