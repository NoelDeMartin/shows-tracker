INSERT DATA {
    @prefix schema: <https://schema.org/> .
    @prefix crdt: <https://vocab.noeldemartin.com/crdt/> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    <#it>
        a schema:TVSeries ;
        schema:name "{{ name }}" ;
        schema:description "[[.*]]" ;
        schema:image <[[.*]]> ;
        schema:sameAs <[[.*]]>, <[[.*]]> ;
        schema:startDate "[[.*]]"^^xsd:dateTime ;
        schema:endDate "[[.*]]"^^xsd:dateTime .

    <#it-metadata>
        a crdt:Metadata ;
        crdt:resource <#it> ;
        crdt:createdAt "[[.*]]"^^xsd:dateTime ;
        crdt:updatedAt "[[.*]]"^^xsd:dateTime .

}
